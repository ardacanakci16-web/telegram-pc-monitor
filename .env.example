# Telegram Bot API Token (Telegram'da @BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# İzin verilen Telegram Chat/User ID'leri (virgülle ayırarak birden fazla yazabilirsiniz)
# Kendi chat ID'nizi öğrenmek için Telegram'da @userinfobot botuna /start yazabilirsiniz.
ALLOWED_CHAT_IDS=123456789

# Otomatik periyodik durum bildirimi aralığı (dakika cinsinden, 0 = devre dışı)
HEARTBEAT_INTERVAL_MINUTES=0
